<Window x:Class="WisperTranslator.App.Windows.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Wisper · Trascrizione"
        Width="760" Height="248" MinWidth="480" MaxWidth="1600"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="#01000000"
        FontFamily="Segoe UI" Foreground="#F3F3F6"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Finestra normale (non a strati) con sfondo quasi trasparente: è il vetro di Windows a
         riempire la finestra, e sono gli angoli arrotondati di DWM a ritagliarlo. Il pannello
         deve quindi riempire la finestra e usare lo stesso raggio di DWM, altrimenti resta
         scoperto un pezzo di vetro con il bordo squadrato. -->
    <Window.Resources>
        <SolidColorBrush x:Key="BarPrimary" Color="#F3F3F6" />
        <SolidColorBrush x:Key="BarSecondary" Color="#B4B4C2" />
        <SolidColorBrush x:Key="BarMuted" Color="#9292A3" />
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource BarSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource BarPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#FF8B73" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#2CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#FF7A59" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Primary" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#14FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Primary" Property="Background" Value="#FF7777" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Primary" Property="Background" Value="#E84F4F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#F3F3F6" />
            <Setter Property="Background" Value="#F022222C" />
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource BarPrimary}" />
            <Setter Property="Background" Value="#F522222C" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" CornerRadius="18" BorderThickness="1" BorderBrush="#35FFFFFF"
            Background="#A6181821" ClipToBounds="True"
            SizeChanged="OnShellSizeChanged"
            PreviewMouseLeftButtonDown="OnShellMouseDown"
            MouseMove="OnShellMouseMove"
            PreviewMouseLeftButtonUp="OnShellMouseUp"
            MouseEnter="OnShellMouseEnter"
            MouseLeave="OnShellMouseLeave">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HandleRowHeight" Height="48" />
                <RowDefinition x:Name="BodyRowHeight" Height="Auto" />
                <RowDefinition x:Name="FooterRowHeight" Height="32" />
            </Grid.RowDefinitions>
            <!-- Il blur è quello del desktop/DWM. Il gradiente aggiunge solo la tinta del vetro. -->
            <Border x:Name="Glass" Grid.RowSpan="3" CornerRadius="17" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                        <GradientStop Color="#0CFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                        <GradientStop Color="#06000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid x:Name="HandleRow" Margin="16,0,12,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#F58B73"
                             HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusLabel" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BarPrimary}" Text="Pronto"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SpeakerHintText" FontSize="10" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource BarMuted}" />
                    </StackPanel>
                </Grid>
                <!-- I comandi restano raggiungibili con mouse e tastiera, anche senza hover. -->
                <StackPanel Grid.Column="1" x:Name="ControlsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SystemButton" Style="{StaticResource GlassButton}" Click="OnSystemClicked"
                            AutomationProperties.Name="Audio di sistema" ToolTip="Audio di sistema">
                        <ui:SymbolIcon Symbol="Speaker024" FontSize="15" />
                    </Button>
                    <Button x:Name="MicrophoneButton" Style="{StaticResource GlassButton}" Click="OnMicrophoneClicked"
                            AutomationProperties.Name="Microfono" ToolTip="Microfono">
                        <ui:SymbolIcon Symbol="Mic24" FontSize="15" />
                    </Button>
                    <Button x:Name="TranslateButton" Style="{StaticResource GlassButton}" Click="OnTranslateClicked"
                            AutomationProperties.Name="Traduzione" ToolTip="Traduzione">
                        <ui:SymbolIcon Symbol="Translate24" FontSize="15" />
                    </Button>
                    <Button x:Name="ConversationButton" Style="{StaticResource GlassButton}" Click="OnConversationClicked"
                            AutomationProperties.Name="Distingui i parlanti" ToolTip="Conversazione">
                        <ui:SymbolIcon Symbol="People24" FontSize="15" />
                    </Button>
                    <Border Width="1" Height="16" Background="#20FFFFFF" Margin="10,0,7,0" />
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Click="OnStartStopClicked"
                            AutomationProperties.Name="Avvia o ferma la trascrizione" ToolTip="Avvia la sessione">
                        <ui:SymbolIcon x:Name="PrimaryIcon" Symbol="Play24" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" x:Name="TranscriptBody" Margin="0,0,0,6">
                <ScrollViewer x:Name="Scroller" Margin="8,0" Focusable="False"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ItemsControl x:Name="CueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Height="76" CornerRadius="12" Margin="0,0,0,4" Padding="13,8"
                                        Background="{Binding RowBackground}"
                                        BorderThickness="1" BorderBrush="{Binding RowEdge}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="1.5" Background="{Binding BadgeForeground}" Opacity="0.9"
                                                Margin="0,4,0,4" />
                                        <Grid Grid.Column="1" Margin="12,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SpeakerLabel}" Foreground="{Binding BadgeForeground}"
                                                           FontSize="10.5" FontWeight="SemiBold" Margin="0,0,10,0"
                                                           Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Original}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BarSecondary}"
                                                           Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" FontSize="15" FontWeight="Medium" LineHeight="20"
                                                       LineStackingStrategy="BlockLineHeight" MaxHeight="40"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasMain, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="{Binding Main, Mode=OneWay}" Foreground="{Binding MainBrush, Mode=OneWay}" /><Run Text="{Binding Trail, Mode=OneWay}" Foreground="{Binding TrailBrush, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="IdlePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="IdleHint" Text="Premi Avvia per i sottotitoli" FontSize="13"
                               Foreground="{DynamicResource BarSecondary}" />
                </StackPanel>
            </Grid>

            <Border x:Name="Footer" Grid.Row="2" BorderBrush="#16FFFFFF" BorderThickness="0,1,0,0" Padding="14,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="DirectionLabel" Text="IT → EN" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BarSecondary}" />
                        <TextBlock x:Name="ModeLabel" Text=" · Traduzione locale" FontSize="10.5"
                                   Foreground="{DynamicResource BarMuted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl Alt B" FontSize="10" Foreground="{DynamicResource BarMuted}"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <Button x:Name="MoreButton" Style="{StaticResource GlassButton}" Height="24"
                                Click="OnMoreClicked" AutomationProperties.Name="Altri comandi" ToolTip="Altri comandi">
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="15" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Cambia direzione" Click="OnSwapClicked" />
                                    <MenuItem Header="Testo mostrato" Click="OnTextModeClicked" />
                                    <MenuItem Header="Modalità discreta" Click="OnDiscreetClicked" />
                                    <Separator />
                                    <MenuItem Header="Sottotitoli a schermo intero" Click="OnOverlayClicked" />
                                    <MenuItem Header="Apri pannello" Click="OnPanelClicked" />
                                    <MenuItem Header="Impostazioni" Click="OnSettingsClicked" />
                                    <Separator />
                                    <MenuItem Header="Nascondi barra" Click="OnHideClicked" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource GlassButton}" Height="24" Click="OnHideClicked"
                                AutomationProperties.Name="Nascondi barra" ToolTip="Nascondi barra · Ctrl+Alt+B">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Modalità minimal: pillola in alto con puntini, prompt e play all'hover. -->
            <Grid x:Name="MiniPanel" Grid.RowSpan="3" Background="Transparent" Visibility="Collapsed">
                <StackPanel x:Name="MiniDots" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="3" Height="3" Fill="#8A8A8E" Margin="2,0" />
                    <Ellipse Width="3" Height="3" Fill="#8A8A8E" Margin="2,0" />
                    <Ellipse Width="3" Height="3" Fill="#8A8A8E" Margin="2,0" />
                    <Ellipse Width="3" Height="3" Fill="#8A8A8E" Margin="2,0" />
                    <Ellipse Width="3" Height="3" Fill="#8A8A8E" Margin="2,0" />
                    <Ellipse Width="3" Height="3" Fill="#8A8A8E" Margin="2,0" />
                </StackPanel>
                <StackPanel x:Name="MiniPrompt" Orientation="Horizontal" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="MiniPromptText" Text="Premi Avvia per i sottotitoli"
                               FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource BarSecondary}" />
                    <Button x:Name="MiniPrimaryButton" Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" Click="OnStartStopClicked"
                            AutomationProperties.Name="Avvia o ferma la trascrizione">
                        <ui:SymbolIcon x:Name="MiniPrimaryIcon" Symbol="Play24" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
