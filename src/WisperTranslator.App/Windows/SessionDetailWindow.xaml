<ui:FluentWindow x:Class="WisperTranslator.App.Windows.SessionDetailWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Sessione"
                 Width="1060"
                 Height="720"
                 MinWidth="760"
                 MinHeight="480"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Sessione" ShowMaximize="True" />

        <TextBlock x:Name="SessionInfo"
                   Grid.Row="1"
                   Margin="16,4,16,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <WrapPanel Grid.Row="2" Margin="16,0,16,8">
            <ui:Button x:Name="SummaryButton" Content="Riassunto" Icon="{ui:SymbolIcon TextBulletList24}"
                       Appearance="Primary" Padding="12,5" Margin="0,0,8,6" Click="OnSummaryClicked" />
            <ui:Button Content="Riassunto dettagliato" Icon="{ui:SymbolIcon Document24}"
                       Padding="12,5" Margin="0,0,8,6" Click="OnDetailedSummaryClicked" />
            <ui:Button Content="Punti chiave" Icon="{ui:SymbolIcon Sparkle24}"
                       Padding="12,5" Margin="0,0,8,6" Click="OnKeyPointsClicked" />
            <ui:Button Content="Mappa concettuale" Icon="{ui:SymbolIcon BrainCircuit24}"
                       Padding="12,5" Margin="0,0,8,6" Click="OnConceptMapClicked" />
            <ui:Button Content="Esporta PDF" Icon="{ui:SymbolIcon DocumentPdf24}"
                       Padding="12,5" Margin="0,0,8,6" Click="OnExportPdfClicked" />
            <Button Content="SRT" Padding="12,5" Margin="0,0,8,6" Click="OnExportSrtClicked" />
            <Button Content="Testo" Padding="12,5" Margin="0,0,8,6" Click="OnExportTextClicked" />
            <Button Content="JSON" Padding="12,5" Margin="0,0,8,6" Click="OnExportJsonClicked" />
            <Button Content="Copia tutto" Padding="12,5" Margin="0,0,8,6" Click="OnCopyAllClicked" />
            <Button Content="Apri cartella" Padding="12,5" Margin="0,0,8,6" Click="OnOpenFolderClicked" />
        </WrapPanel>

        <WrapPanel Grid.Row="3" Margin="16,0,16,8">
            <TextBlock Text="Template mappa" VerticalAlignment="Center" Margin="0,0,6,6" />
            <ComboBox x:Name="MapTemplateBox" Width="196" DisplayMemberPath="Name" Margin="0,0,12,6"
                      SelectionChanged="OnMapTemplateChanged" />
            <TextBlock Text="Orientamento" VerticalAlignment="Center" Margin="0,0,6,6" />
            <ComboBox x:Name="MapOrientationBox" Width="130" DisplayMemberPath="Label" Margin="0,0,12,6"
                      SelectionChanged="OnMapTemplateChanged" />
            <TextBlock Text="Palette" VerticalAlignment="Center" Margin="0,0,6,6" />
            <ComboBox x:Name="MapPaletteBox" Width="160" DisplayMemberPath="Label" Margin="0,0,12,6"
                      SelectionChanged="OnMapTemplateChanged" />
            <TextBlock Text="Template PDF" VerticalAlignment="Center" Margin="0,0,6,6" />
            <ComboBox x:Name="PdfTemplateBox" Width="196" DisplayMemberPath="Name" Margin="0,0,12,6"
                      SelectionChanged="OnPdfTemplateChanged" />
        </WrapPanel>

        <Grid Grid.Row="4" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="6" Padding="4"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4,6,10">
                                    <TextBlock Text="{Binding Header}" FontSize="10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Speaker}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding SpeakerColor}"
                                               Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Original}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" CornerRadius="6"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <TabControl x:Name="AiTabs" Margin="4">
                    <TabItem Header="Riassunto">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="10" Text="Nessun riassunto." />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Punti chiave">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="KeyPointsText" TextWrapping="Wrap" Margin="10" Text="Nessun punto chiave." />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Mappa">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="MapImage" Margin="10" Stretch="None" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="5" Padding="16,6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <TextBlock x:Name="StatusText" Text="Pronto" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</ui:FluentWindow>
