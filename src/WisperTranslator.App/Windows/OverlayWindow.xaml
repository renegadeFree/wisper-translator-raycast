<Window x:Class="WisperTranslator.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wisper Translator Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False"
        Focusable="False">
    <Grid>
        <ItemsControl x:Name="CueList"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="40,0,40,64"
                      MaxWidth="1200">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#B0000000" CornerRadius="8" Padding="16,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Original}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="#CCFFFFFF"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=0.62}" />
                            <TextBlock Text="{Binding ProvisionalTail}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       FontStyle="Italic"
                                       Foreground="#99FFFFFF"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=0.62}"
                                       Visibility="{Binding HasProvisional, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Translation}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="#FFFFFFFF"
                                       FontWeight="SemiBold"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
