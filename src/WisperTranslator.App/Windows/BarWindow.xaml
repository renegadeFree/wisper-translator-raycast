<Window x:Class="WisperTranslator.App.Windows.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Wisper · Trascrizione"
        Width="760" Height="248" MinWidth="480" MaxWidth="1600"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        Foreground="#FFFFFF"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BarPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BarSecondary" Color="#CBD5E1" />
        <SolidColorBrush x:Key="BarMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="BarActiveAccent" Color="#10B981" />

        <!-- Pulsanti di controllo a pillola stile Raycast / Apple Glass -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource BarSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource BarPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulsante di azione primario vivace (Play / Stop) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#FF5733" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Primary" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#30FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Primary" Property="Background" Value="#FF6F4E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Primary" Property="Background" Value="#E04622" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#F514141E" />
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource BarPrimary}" />
            <Setter Property="Background" Value="#F514141E" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Barra fluttuante Raycast ad alto contrasto: dark obsidian quasi solido con micro-bordo luminoso -->
    <Border x:Name="Shell" CornerRadius="18" BorderThickness="1"
            RenderOptions.ClearTypeHint="Enabled"
            Background="#F5111116" ClipToBounds="True"
            SizeChanged="OnShellSizeChanged"
            PreviewMouseLeftButtonDown="OnShellMouseDown"
            MouseMove="OnShellMouseMove"
            PreviewMouseLeftButtonUp="OnShellMouseUp"
            MouseEnter="OnShellMouseEnter"
            MouseLeave="OnShellMouseLeave">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#1CFFFFFF" Offset="0.3" />
                <GradientStop Color="#10FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HandleRowHeight" Height="48" />
                <RowDefinition x:Name="BodyRowHeight" Height="*" />
                <RowDefinition x:Name="FooterRowHeight" Height="34" />
            </Grid.RowDefinitions>

            <!-- Riflesso di luce superiore stile Apple Glass -->
            <Border x:Name="Glass" Grid.RowSpan="3" CornerRadius="17" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#10FFFFFF" Offset="0" />
                        <GradientStop Color="#03FFFFFF" Offset="0.16" />
                        <GradientStop Color="#00000000" Offset="0.45" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Riga Intestazione / Maniglia comandi -->
            <Grid x:Name="HandleRow" Margin="16,0,10,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Spia di stato con micro-alone -->
                    <Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock x:Name="StatusLabel" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BarPrimary}" Text="Pronto"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SpeakerHintText" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource BarMuted}" />
                    </StackPanel>
                </Grid>

                <!-- Barra comandi a pillola -->
                <StackPanel Grid.Column="1" x:Name="ControlsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SystemButton" Style="{StaticResource GlassButton}" Click="OnSystemClicked"
                            AutomationProperties.Name="Audio di sistema" ToolTip="Audio di sistema">
                        <ui:SymbolIcon Symbol="Speaker024" FontSize="15" />
                    </Button>
                    <Button x:Name="MicrophoneButton" Style="{StaticResource GlassButton}" Click="OnMicrophoneClicked"
                            AutomationProperties.Name="Microfono" ToolTip="Microfono">
                        <ui:SymbolIcon Symbol="Mic24" FontSize="15" />
                    </Button>
                    <Button x:Name="TranslateButton" Style="{StaticResource GlassButton}" Click="OnTranslateClicked"
                            AutomationProperties.Name="Traduzione" ToolTip="Traduzione">
                        <ui:SymbolIcon Symbol="Translate24" FontSize="15" />
                    </Button>
                    <Button x:Name="ConversationButton" Style="{StaticResource GlassButton}" Click="OnConversationClicked"
                            AutomationProperties.Name="Distingui i parlanti" ToolTip="Conversazione">
                        <ui:SymbolIcon Symbol="People24" FontSize="15" />
                    </Button>
                    <Border Width="1" Height="16" Background="#22FFFFFF" Margin="6,0,8,0" />
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Click="OnStartStopClicked"
                            AutomationProperties.Name="Avvia o ferma la trascrizione" ToolTip="Avvia la sessione">
                        <ui:SymbolIcon x:Name="PrimaryIcon" Symbol="Play24" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Corpo trascrizioni: card conversazionali moderne ad alto contrasto -->
            <Grid Grid.Row="1" x:Name="TranscriptBody" Margin="0,0,0,6">
                <ScrollViewer x:Name="Scroller" Margin="10,0" Focusable="False"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ItemsControl x:Name="CueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" CornerRadius="10" Margin="0,0,0,5" Padding="12,8"
                                        Background="{Binding RowBackground}"
                                        BorderThickness="1" BorderBrush="{Binding RowEdge}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Indicatore laterale a pillola colorata del parlante -->
                                        <Border CornerRadius="1.5" Background="{Binding BadgeForeground}"
                                                Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,2,0,2"
                                                Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVisibility}}" />
                                        <Grid Grid.Column="1" Margin="10,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <!-- Intestazione: Badge parlante e testo originale ad alto contrasto -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Pillola parlante stile Raycast -->
                                                <Border Background="{Binding BadgeBackground}" CornerRadius="5"
                                                        Padding="6,1.5" Margin="0,0,8,0"
                                                        BorderBrush="{Binding BadgeForeground}" BorderThickness="0.5"
                                                        Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding SpeakerLabel}" Foreground="{Binding BadgeForeground}"
                                                               FontSize="{Binding SecondaryFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Original}"
                                                           FontSize="{Binding SecondaryFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource BarSecondary}"
                                                           Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                            <!-- Testo principale tradotto/trascritto: BIANCO PURO con font size dinamico -->
                                            <TextBlock Grid.Row="1"
                                                       FontSize="{Binding BarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasMain, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="{Binding Main, Mode=OneWay}" Foreground="{Binding MainBrush, Mode=OneWay}" /><Run Text="{Binding Trail, Mode=OneWay}" Foreground="{Binding TrailBrush, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="IdlePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="IdleHint" Text="Premi Avvia per i sottotitoli" FontSize="13"
                               FontWeight="Medium" Foreground="{DynamicResource BarSecondary}" />
                </StackPanel>
            </Grid>

            <!-- Piè di pagina con chip stile macOS / Raycast -->
            <Border x:Name="Footer" Grid.Row="2" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="14,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Chip Direzione Lingua -->
                        <Border Background="#20FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                                CornerRadius="5" Padding="7,2" Margin="0,0,8,0">
                            <TextBlock x:Name="DirectionLabel" Text="IT → EN" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BarPrimary}" />
                        </Border>
                        <TextBlock x:Name="ModeLabel" Text="· Traduzione locale" FontSize="10.5"
                                   Foreground="{DynamicResource BarMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Keycap chip Raycast -->
                        <Border Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                CornerRadius="4" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl Alt B" FontSize="9.5" FontWeight="Medium"
                                       Foreground="{DynamicResource BarSecondary}" />
                        </Border>
                        <Button x:Name="MoreButton" Style="{StaticResource GlassButton}" Height="26" Width="26"
                                Click="OnMoreClicked" AutomationProperties.Name="Altri comandi" ToolTip="Altri comandi">
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Cambia direzione" Click="OnSwapClicked" />
                                    <MenuItem Header="Testo mostrato" Click="OnTextModeClicked" />
                                    <MenuItem Header="Modalità discreta" Click="OnDiscreetClicked" />
                                    <Separator />
                                    <MenuItem Header="Sottotitoli a schermo intero" Click="OnOverlayClicked" />
                                    <MenuItem Header="Apri pannello" Click="OnPanelClicked" />
                                    <MenuItem Header="Impostazioni" Click="OnSettingsClicked" />
                                    <Separator />
                                    <MenuItem Header="Nascondi barra" Click="OnHideClicked" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource GlassButton}" Height="26" Width="26" Click="OnHideClicked"
                                AutomationProperties.Name="Nascondi barra" ToolTip="Nascondi barra · Ctrl+Alt+B">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Modalità minimal: capsula Dynamic Island con onde luminose -->
            <Grid x:Name="MiniPanel" Grid.RowSpan="3" Background="Transparent" Visibility="Collapsed">
                <StackPanel x:Name="MiniDots" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="4" Height="4" Fill="#10B981" Margin="3,0" />
                    <Ellipse Width="4" Height="4" Fill="#34D399" Margin="3,0" />
                    <Ellipse Width="5" Height="5" Fill="#6EE7B7" Margin="3,0" />
                    <Ellipse Width="4" Height="4" Fill="#34D399" Margin="3,0" />
                    <Ellipse Width="4" Height="4" Fill="#10B981" Margin="3,0" />
                </StackPanel>
                <StackPanel x:Name="MiniPrompt" Orientation="Horizontal" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="MiniPromptText" Text="Premi Avvia per i sottotitoli"
                               FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"
                               Foreground="{DynamicResource BarSecondary}" />
                    <Button x:Name="MiniPrimaryButton" Style="{StaticResource PrimaryButton}"
                            Width="28" Height="26" Margin="10,0,0,0" Click="OnStartStopClicked"
                            AutomationProperties.Name="Avvia o ferma la trascrizione">
                        <ui:SymbolIcon x:Name="MiniPrimaryIcon" Symbol="Play24" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
