<ui:FluentWindow x:Class="WisperTranslator.App.Windows.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Impostazioni"
                 Width="620"
                 Height="560"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Impostazioni" ShowMaximize="False" />

        <TabControl Grid.Row="1" x:Name="Tabs" Margin="12,4,12,0">
            <TabItem Header="Aspetto e sessione">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock Text="Dimensione testo widget" Margin="0,0,0,2" />
                        <Slider x:Name="FontSlider" Minimum="10" Maximum="32" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />

                        <TextBlock Text="Opacità finestra" Margin="0,12,0,2" />
                        <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />

                        <TextBlock Text="Battute massime nel widget" Margin="0,12,0,2" />
                        <Slider x:Name="MaxCuesSlider" Minimum="3" Maximum="20" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />

                        <TextBlock Text="Battute nell'overlay" Margin="0,12,0,2" />
                        <Slider x:Name="OverlayCuesSlider" Minimum="1" Maximum="6" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />

                        <TextBlock Text="Dimensione testo overlay" Margin="0,12,0,2" />
                        <Slider x:Name="OverlayFontSlider" Minimum="16" Maximum="56" TickFrequency="2"
                                IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />

                        <CheckBox x:Name="TopmostCheck" Content="Sempre in primo piano" Margin="0,16,0,0"
                                  Click="OnAppearanceChanged" />
                        <CheckBox x:Name="ShowOriginalCheck" Content="Mostra anche il testo originale" Margin="0,8,0,0"
                                  Click="OnAppearanceChanged" />
                        <CheckBox x:Name="TranslateCheck" Content="Traduci le battute" Margin="0,8,0,0"
                                  Click="OnAppearanceChanged" />
                        <CheckBox x:Name="OverlayCaptureCheck" Content="Nascondi l'overlay dalle registrazioni"
                                  Margin="0,8,0,0" Click="OnAppearanceChanged" />
                        <CheckBox x:Name="CloseToTrayCheck" Content="Chiudendo la finestra resta nella barra delle applicazioni"
                                  Margin="0,8,0,0" Click="OnAppearanceChanged" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Avvia con Windows"
                                  Margin="0,8,0,0" Click="OnAppearanceChanged" />

                        <TextBlock Text="Conservazione delle sessioni (giorni, 0 = per sempre)" Margin="0,14,0,2" />
                        <Slider x:Name="RetentionSlider" Minimum="0" Maximum="90" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="Modello per i parziali (veloce)" Margin="0,0,0,4" />
                        <ComboBox x:Name="PartialModelBox" DisplayMemberPath="Id"
                                  SelectionChanged="OnModelChanged" />

                        <TextBlock Text="Modello per le frasi finali (accurato)" Margin="0,12,0,4" />
                        <ComboBox x:Name="FinalModelBox" DisplayMemberPath="Id"
                                  SelectionChanged="OnModelChanged" />

                        <TextBlock x:Name="ModelHint" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="Dispositivo audio di sistema" Margin="0,0,0,4" />
                        <ComboBox x:Name="SystemDeviceBox" DisplayMemberPath="Name" SelectionChanged="OnDeviceChanged" />

                        <TextBlock Text="Dispositivo microfono" Margin="0,12,0,4" />
                        <ComboBox x:Name="MicrophoneDeviceBox" DisplayMemberPath="Name" SelectionChanged="OnDeviceChanged" />

                        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Scorciatoie: Ctrl+Alt+W mostra/nascondi · Ctrl+Alt+S audio di sistema · Ctrl+Alt+N microfono · Ctrl+Alt+L inverti direzione · Ctrl+Alt+O overlay" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Modelli">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <Border Padding="10" CornerRadius="6" Margin="0,0,0,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock x:Name="HardwareText" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Applica i modelli consigliati" Padding="10,4"
                                            Click="OnApplyRecommendedClicked" />
                                    <Button Content="Aggiorna elenco" Padding="10,4" Margin="8,0,0,0"
                                            Click="OnRefreshModelsClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="ModelsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,6" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding About}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Scarica" Padding="10,3" Click="OnModelDownloadClicked" />
                                                <Button Content="Verifica" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnModelVerifyClicked" />
                                                <Button Content="Elimina" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnModelDeleteClicked" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ProgressBar x:Name="ModelProgress" Height="6" Margin="0,10,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="ModelStatusText" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Importa modello da file..." Padding="10,4" Click="OnImportModelClicked" />
                        </StackPanel>

                        <TextBlock x:Name="ModelFolderText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Storico">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <Border Padding="10" CornerRadius="6" Margin="0,0,0,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock x:Name="HistorySummary" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Aggiorna" Padding="10,4" Click="OnRefreshHistoryClicked" />
                                    <Button Content="Elimina sessioni scadute" Padding="10,4" Margin="8,0,0,0"
                                            Click="OnPurgeHistoryClicked" />
                                    <Button Content="Apri cartella dati" Padding="10,4" Margin="8,0,0,0"
                                            Click="OnOpenFolderClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="HistoryList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,6" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="SRT" Padding="10,3" Click="OnExportSrtClicked" />
                                                <Button Content="Testo" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnExportTextClicked" />
                                                <Button Content="JSON" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnExportJsonClicked" />
                                                <Button Content="Apri sessione" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnOpenSessionClicked" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Intelligenza artificiale">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock Text="Provider" Margin="0,0,0,4" />
                        <ComboBox x:Name="AiProviderBox" DisplayMemberPath="Name"
                                  SelectionChanged="OnAiProviderChanged" />

                        <TextBlock Text="Endpoint" Margin="0,12,0,4" />
                        <TextBox x:Name="AiEndpointBox" LostFocus="OnAiTextChanged" />

                        <TextBlock Text="Modello" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AiModelBox" IsEditable="True" LostFocus="OnAiTextChanged"
                                      SelectionChanged="OnAiTextChanged" />
                            <Button Grid.Column="1" Content="Rileva modelli" Padding="10,4" Margin="8,0,0,0"
                                    Click="OnDetectModelsClicked" ToolTip="Elenca i modelli installati in Ollama o LM Studio" />
                        </Grid>

                        <TextBlock Text="Chiave API (vuota per i servizi locali)" Margin="0,12,0,4" />
                        <PasswordBox x:Name="AiKeyBox" LostFocus="OnAiSecretChanged" />

                        <TextBlock Text="Lingua dei testi generati" Margin="0,12,0,4" />
                        <ComboBox x:Name="AiLanguageBox" SelectionChanged="OnAiTextChanged">
                            <ComboBoxItem Content="Italiano" />
                            <ComboBoxItem Content="Inglese" />
                        </ComboBox>

                        <TextBlock Text="Temperatura (0 = preciso, 1 = creativo)" Margin="0,12,0,2" />
                        <Slider x:Name="AiTemperatureSlider" Minimum="0" Maximum="1" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" ValueChanged="OnAiSliderChanged" />

                        <TextBlock Text="Token massimi di risposta" Margin="0,12,0,4" />
                        <TextBox x:Name="AiMaxTokensBox" LostFocus="OnAiTextChanged" />

                        <TextBlock Text="Timeout (secondi)" Margin="0,12,0,4" />
                        <TextBox x:Name="AiTimeoutBox" LostFocus="OnAiTextChanged" />

                        <CheckBox x:Name="AiSkipReasoningCheck"
                                  Content="Salta il ragionamento dei modelli thinking (consigliato)"
                                  Margin="0,12,0,0" Click="OnAiCheckChanged" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button x:Name="AiTestButton" Content="Testa la connessione"
                                       Icon="{ui:SymbolIcon Sparkle24}" Padding="12,5"
                                       Click="OnTestAiClicked" />
                            <Button Content="Provider noti" Padding="12,5" Margin="8,0,0,0"
                                    Click="OnAiPresetsClicked" />
                        </StackPanel>

                        <TextBlock x:Name="AiStatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Con Ollama (locale) e LM Studio nessun dato esce dal PC. Con i provider cloud il testo della sessione viene inviato al servizio scelto e la chiave resta salvata solo su questo computer." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <Button Content="Chiudi" Padding="14,5" Click="OnCloseClicked" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
