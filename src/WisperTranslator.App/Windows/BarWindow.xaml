<ui:FluentWindow x:Class="WisperTranslator.App.Windows.BarWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Wisper Translator"
                 Width="1000"
                 Height="240"
                 MinWidth="480"
                 MaxWidth="1600"
                 WindowStyle="None"
                 ResizeMode="CanResize"
                 ShowInTaskbar="False"
                 ShowActivated="False"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="DoNotRound"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent">
    <Window.Resources>
        <!-- Pulsanti incassati: compaiono al passaggio del mouse, come nei riferimenti. -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle"
                                CornerRadius="15"
                                Background="#1CFFFFFF"
                                BorderThickness="1"
                                BorderBrush="#14FFFFFF"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CircleScale" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#30FFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CircleScale"
                                                             Storyboard.TargetProperty="ScaleX" To="1.08"
                                                             Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="CircleScale"
                                                             Storyboard.TargetProperty="ScaleY" To="1.08"
                                                             Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CircleScale"
                                                             Storyboard.TargetProperty="ScaleX" To="1"
                                                             Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="CircleScale"
                                                             Storyboard.TargetProperty="ScaleY" To="1"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulsante principale: sempre visibile, diventa corallo durante l'ascolto. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle"
                                CornerRadius="19"
                                Background="#FF7A59"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PrimaryScale" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PrimaryScale"
                                                             Storyboard.TargetProperty="ScaleX" To="1.08"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PrimaryScale"
                                                             Storyboard.TargetProperty="ScaleY" To="1.08"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PrimaryScale"
                                                             Storyboard.TargetProperty="ScaleX" To="1"
                                                             Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="PrimaryScale"
                                                             Storyboard.TargetProperty="ScaleY" To="1"
                                                             Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PrimaryScale"
                                                             Storyboard.TargetProperty="ScaleX" To="0.92"
                                                             Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="PrimaryScale"
                                                             Storyboard.TargetProperty="ScaleY" To="0.92"
                                                             Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Una sola superficie: la finestra intera è ritagliata ad angoli arrotondati via SetWindowRgn. -->
    <Border x:Name="Shell"
            CornerRadius="20"
            BorderThickness="1"
            Background="Transparent"
            BorderBrush="#26FFFFFF"
            MouseLeftButtonDown="OnShellDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Luce appena percettibile in alto: dà profondità senza aggiungere un secondo rettangolo. -->
            <Border x:Name="Glass" Grid.RowSpan="2" CornerRadius="19" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.45" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Riga comandi: stato e controlli compatti, nessun titolo. -->
            <Grid x:Name="HandleRow" Grid.Row="0" Margin="16,0,12,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF7A59"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusLabel" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold"
                               MaxWidth="420" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Pronto" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="SpeakerHintText" HorizontalAlignment="Right"
                           Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="ControlsPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                Opacity="0" RenderTransformOrigin="1,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="ControlsScale" />
                        </StackPanel.RenderTransform>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                                     Duration="0:0:0.16" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                                     Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button x:Name="SystemButton" Style="{StaticResource GlassButton}"
                                Click="OnSystemClicked" ToolTip="Audio di sistema">
                            <ui:SymbolIcon Symbol="Speaker024" FontSize="13" />
                        </Button>
                        <Button x:Name="MicrophoneButton" Style="{StaticResource GlassButton}"
                                Click="OnMicrophoneClicked" ToolTip="Microfono">
                            <ui:SymbolIcon Symbol="Mic24" FontSize="13" />
                        </Button>
                        <Button x:Name="TranslateButton" Style="{StaticResource GlassButton}"
                                Click="OnTranslateClicked" ToolTip="Traduci">
                            <ui:SymbolIcon Symbol="Translate24" FontSize="13" />
                        </Button>
                        <Button x:Name="ConversationButton" Style="{StaticResource GlassButton}"
                                Click="OnConversationClicked" ToolTip="Conversazione">
                            <ui:SymbolIcon Symbol="People24" FontSize="13" />
                        </Button>

                        <Button x:Name="MoreButton" Style="{StaticResource GlassButton}" ToolTip="Altri comandi">
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="13" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Cambia direzione" Click="OnSwapClicked" />
                                    <MenuItem Header="Testo mostrato" Click="OnTextModeClicked" />
                                    <MenuItem Header="Modalità discreta" Click="OnDiscreetClicked" />
                                    <Separator />
                                    <MenuItem Header="Sottotitoli a schermo intero" Click="OnOverlayClicked" />
                                    <MenuItem Header="Apri pannello" Click="OnPanelClicked" />
                                    <MenuItem Header="Impostazioni" Click="OnSettingsClicked" />
                                    <Separator />
                                    <MenuItem Header="Nascondi barra" Click="OnHideClicked" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Click="OnStartStopClicked" ToolTip="Avvia o ferma">
                        <ui:SymbolIcon x:Name="PrimaryIcon" Symbol="Play24" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="Scroller" Margin="10,0,10,8"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ItemsControl x:Name="CueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Height="86" CornerRadius="14" Margin="0,0,0,6" Padding="14,10"
                                        Background="{Binding RowBackground}" MouseLeftButtonDown="OnShellDrag">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Lampo corallo sulla frase appena consolidata: è un livello
                                             separato, così la riga non resta colorata per sempre. -->
                                        <Border x:Name="FlashLayer" Grid.ColumnSpan="2" CornerRadius="12"
                                                Background="#26FF7A59" Opacity="0" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Flash}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0.9" To="0"
                                                                                         Duration="0:0:0.55">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border VerticalAlignment="Top" Margin="0,1,10,0" CornerRadius="9"
                                                Padding="8,2" Height="19"
                                                Background="{Binding BadgeBackground}"
                                                Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding SpeakerLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding BadgeForeground}" />
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Original}" FontSize="12" Height="18"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                                                       MaxHeight="44" LineHeight="21"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasMain, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="{Binding Main, Mode=OneWay}"
                                                     Foreground="{Binding MainBrush, Mode=OneWay}" />
                                                <Run Text="{Binding Trail, Mode=OneWay}"
                                                     Foreground="{Binding TrailBrush, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="BottomFade" Height="18" VerticalAlignment="Bottom" IsHitTestVisible="False"
                        CornerRadius="0,0,18,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#66000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <TextBlock x:Name="IdleHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Premi Avvia per i sottotitoli" FontSize="13.5" Opacity="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
